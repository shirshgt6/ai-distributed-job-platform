PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/job_queue_system
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme2
